{
  "name": "checkthis",
  "version": "0.1.0",
  "description": "Offline-first file and directory inspection tool",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "checkthis": "./bin/checkthis"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "filesystem",
    "inspection",
    "cli",
    "directory"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrfanNaikwade28/checkthis.git"
  },
  "bugs": {
    "url": "https://github.com/IrfanNaikwade28/checkthis/issues"
  },
  "homepage": "https://github.com/IrfanNaikwade28/checkthis#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
